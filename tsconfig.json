{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Only typechecks the examples; packages build with their own config.
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@floruntime/core": ["./packages/core/src"],
      "@floruntime/node": ["./packages/node/src"]
    }
  },
  "include": ["examples/**/*"],
  "exclude": ["node_modules", "dist"]
}
