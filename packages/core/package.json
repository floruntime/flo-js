    "type": "git",
    "url": "git+https://github.com/floruntime/flo-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/floruntime/flo-js#readme",
  "bugs": {
    "url": "https://github.com/floruntime/flo-js/issues"
  }
