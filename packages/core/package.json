{
  "name": "@floruntime/core",
  "version": "0.1.0-dev.10",
  "description": "Flo SDK core - wire protocol, types, and transport-agnostic operations",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
