{
  "name": "@floruntime/node",
  "version": "0.1.0-dev.3",
  "description": "Flo SDK for Node.js - TCP transport for streams, KV, queues, and workers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@floruntime/core": "workspace:*"
  },
  "keywords": [
    "flo",
    "floruntime",
    "sdk",
    "nodejs",
    "streams",
    "kv",
    "queue",
    "pubsub"
  ],
  "author": "Flo Authors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/floruntime/flo",
    "directory": "sdks/js/packages/node"
  },
  "homepage": "https://github.com/floruntime/flo/tree/main/sdks/js#readme",
  "bugs": {
    "url": "https://github.com/floruntime/flo/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
